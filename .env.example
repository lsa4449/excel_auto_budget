# 이 파일을 .env 로 복사한 뒤 값을 바꾸세요. (.env 는 Git에 올라가지 않습니다)
# 토큰 만들기: python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=change-me-to-a-long-random-string

# 한 달 예산(원). 0이면 예산 비교 생략
MONTHLY_BUDGET=1500000

# 저장 위치 (상대경로는 프로젝트 폴더 기준)
DB_PATH=data/budget.db
# OneDrive/Google Drive 동기화 폴더로 지정하면 휴대폰에서도 엑셀을 바로 열 수 있음
# 예) EXPORT_DIR=C:/Users/me/OneDrive/가계부
EXPORT_DIR=exports

# 문자+앱푸시로 같은 결제가 두 번 올 때 중복으로 보는 시간(분)
DEDUP_MINUTES=3

# scripts/send_test.py 가 사용할 서버 주소
SERVER_URL=http://127.0.0.1:8000
